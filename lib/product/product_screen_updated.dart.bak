  ////////////////////////search items//////////////////////////////////////////////
  Future<dynamic> getStoreProductSearchList({
    required String query,
    int page = 1,
  }) async {
    var url =
        "${Provider.of<ZMetaData>(context, listen: false).baseUrl}/api/user/search_store_item_by_name";
    Map data = {
      "name": query,
      "page": page.toString(),
      "store_id": widget.store['_id'],
    };

    var body = json.encode(data);
    // debugPrint("body : $body");

    try {
      http.Response response = await http
          .post(
            Uri.parse(url),
            headers: <String, String>{
              "Content-Type": "application/json",
              "Accept": "application/json",
            },
            body: body,
          )
          .timeout(
            Duration(seconds: 60),
            onTimeout: () {
              Service.showMessage(
                context: context,
                title: "Something went wrong!",
                error: true,
                duration: 3,
              );
              throw TimeoutException("The connection has timed out!");
            },
          );
      // debugPrint("response: ${json.decode(response.body)}");
      return json.decode(response.body);
    } catch (e) {
      // debugPrint("error: $e");

      return null;
    } finally {
      setState(() {
        _loading = false;
      });
    }
  }

  /////////////////////////////////////////////////////////////////////
  Future<void> _loadPage(
    int page, {
    bool isLoadMore = false,
    bool isRefresh = false,
  }) async {
    if (isLoadMore) {
      if (_isLoadingMore || !_hasMore) return;
      setState(() => _isLoadingMore = true);
    } else {
      setState(() {
        _loading = true;
        if (isRefresh) {
          currentPage = 1;
          _hasMore = true;
          products = null; // force rebuild
        }
      });
    }

    final result = await getStoreProductList(page: page);

    if (!mounted) return;

    if (result != null && result['success'] == true) {
      final newProducts = result['products'] ?? [];
      final limit = result['limit'] ?? 10;

      int calculatedTotalPages;
      if (result['total_pages'] != null) {
        calculatedTotalPages = result['total_pages'];
      } else {
        final totalItems = result['total'] ?? 0;
        calculatedTotalPages = (totalItems / limit).ceil().clamp(1, 9999);
      }

      setState(() {
        currentPage = page;
        totalPages = calculatedTotalPages;
        _hasMore = currentPage < totalPages;

        if (isLoadMore && products != null) {
          // Append new categories
          products = [...products, ...newProducts];
        } else {
          products = newProducts;
        }
      });
      //
      _checkAndLoadMoreIfNeeded(isSearch: false);
    } else {
      if (mounted && result != null) {
        final code = result['error_code']?.toString() ?? '';
        final msg = (code.isNotEmpty && errorCodes.containsKey(code))
            ? errorCodes[code]
            : result['message']?.toString() ?? 'Failed to load products';
        Service.showMessage(context: context, title: msg, error: true);
      }
      if (isLoadMore) {
        // Keep _hasMore true so user can retry by scrolling again if desired
      }
    }

    if (mounted) {
      setState(() {
        _loading = false;
        _isLoadingMore = false;
      });
    }
  }

  Future<void> _loadSearchPage(
    int page, {
    String? query,
    bool isLoadMore = false,
    bool isRefresh = false,
  }) async {
    final searchQuery = query ?? _lastSearchQuery;
    if (searchQuery.isEmpty) return;

    if (isLoadMore) {
      if (_isLoadingMore || !_searchHasMore) return;
      setState(() => _isLoadingMore = true);
    } else {
      setState(() {
        _loading = true;
        if (isRefresh) {
          searchCurrentPage = 1;
          _searchHasMore = true;
          _searchResult.clear();
        }
      });
    }

    final data = await getStoreProductSearchList(
      query: searchQuery,
      page: page,
    );

    if (!mounted) return;

    if (data != null && data['success'] == true) {
      final newItems = data['items'] ?? [];
      final limit = data['limit'] ?? 10;

      int calculatedTotalPages;
      if (data['total_pages'] != null) {
        calculatedTotalPages = data['total_pages'];
      } else {
        final totalItems = data['item_length'] ?? 0;
        calculatedTotalPages = (totalItems / limit).ceil().clamp(1, 9999);
      }

      setState(() {
        _lastSearchQuery = searchQuery;
        searchCurrentPage = page;
        searchTotalPages = calculatedTotalPages;
        _searchHasMore = searchCurrentPage < searchTotalPages;

        if (isLoadMore) {
          _searchResult = [..._searchResult, ...newItems];
        } else {
          _searchResult = newItems;
        }
      });
      //
      _checkAndLoadMoreIfNeeded(isSearch: true);
    } else {
      if (mounted && data != null) {
        final code = data['error_code']?.toString() ?? '';
        final msg = (code.isNotEmpty && errorCodes.containsKey(code))
            ? errorCodes[code]
            : data['message']?.toString() ?? 'Failed to load products';
        Service.showMessage(context: context, title: msg, error: true);
        if (code == '999') {
          await Service.saveBool('logged', false);
          await Service.remove('user');
          Navigator.pushReplacementNamed(context, LoginScreen.routeName);
        }
      }
    }

    if (mounted) {
      setState(() {
        _loading = false;
        _isLoadingMore = false;
      });
    }
  }

  // product list with pageination
  Future<dynamic> getStoreProductList({int page = 1}) async {
    var url =
        "${Provider.of<ZMetaData>(context, listen: false).baseUrl}/api/user/user_get_store_product_item_list_with_pagination";
    Map data = {"store_id": widget.store['_id'], "page": page.toString()};
    var body = json.encode(data);
    // debugPrint("body : $body");

    try {
      http.Response response = await http
          .post(
            Uri.parse(url),
            headers: <String, String>{
              "Content-Type": "application/json",
              "Accept": "application/json",
            },
            body: body,
          )
          .timeout(
            Duration(seconds: 60),
            onTimeout: () {
              Service.showMessage(
                context: context,
                title: "Something went wrong!",
                error: true,
                duration: 3,
              );
              throw TimeoutException("The connection has timed out!");
            },
          );
      // debugPrint("response: ${json.decode(response.body)}");
      return json.decode(response.body);
    } catch (e) {
      // debugPrint("error : $e");

      return null;
    } finally {
      setState(() {
        _loading = false;
      });
    }
    // Old product list API without pagination
    // var url ="${Provider.of<ZMetaData>(context, listen: false).baseUrl}/api/user/user_get_store_product_item_list";
    // Map data = {"store_id": widget.store['_id']};
  }

  void productClicked(String productId) async {
    var url =
        "${Provider.of<ZMetaData>(context, listen: false).baseUrl}/api/admin/add_user_and_store";
    Map data = {
      "store_id": widget.store['_id'],
      "product_id": productId,
      "user_id": userData['user']['_id'],
      "latitude": widget.latitude,
      "longitude": widget.longitude,
      "is_promotional": false,
    };
    var body = json.encode(data);
    try {
      await http.post(
        Uri.parse(url),
        headers: <String, String>{
          "Content-Type": "application/json",
          "Accept": "application/json",
        },
        body: body,
      );
    } catch (e) {
      // debugPrint(e);
    }
  }

  void _showDialog(item, destination, storeLocation, storeId) {
    showDialog(
      context: context,
      builder: (BuildContext alertContext) {
        return AlertDialog(
          backgroundColor: kPrimaryColor,
          title: Text(Provider.of<ZLanguage>(context).warning),
          content: Text(Provider.of<ZLanguage>(context).itemsFound),
          actions: [
            TextButton(
              child: Text(
                Provider.of<ZLanguage>(context).cancel,
                style: TextStyle(
                  color: kBlackColor,
                  fontWeight: FontWeight.bold,
                ),
              ),
              onPressed: () {
                Navigator.of(alertContext).pop();
              },
            ),
            TextButton(
              child: Text(
                Provider.of<ZLanguage>(context).clear,
                style: TextStyle(
                  color: kSecondaryColor,
                  fontWeight: FontWeight.bold,
                ),
              ),
              onPressed: () {
                setState(() {
                  cart!.toJson();
                  Service.remove('cart');
                  Service.remove('aliexpressCart');
                  cart = Cart();
                  addToCart(item, destination, storeLocation, storeId);
                });

                Navigator.of(alertContext).pop();
                // Future.delayed(Duration(seconds: 2));
                // Navigator.of(context).pop();
              },
            ),
          ],
        );
      },
    );
  }
}
